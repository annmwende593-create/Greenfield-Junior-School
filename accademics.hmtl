<main class="container">
    <h2>Our Academic Programme</h2>

    <p>
        We provide a balanced education that encourages learners
        to develop knowledge, practical skills and positive values.
    </p>

    <h3>Classes Offered</h3>
    <ul>
        <li>Pre-Primary</li>
        <li>Grade 1</li>
        <li>Grade 2</li>
        <li>Grade 3</li>
        <li>Grade 4</li>
        <li>Grade 5</li>
        <li>Grade 6</li>
    </ul>

    <h3>Learning Areas</h3>

    <div class="cards">
        <div class="card">
            <h4>Languages</h4>
            <p>English, Kiswahili and communication skills.</p>
        </div>

        <div class="card">
            <h4>Mathematics</h4>
            <p>Numeracy, logical thinking and problem-solving.</p>
        </div>

        <div class="card">
            <h4>Science</h4>
            <p>Scientific discovery, observation and experiments.</p>
        </div>

        <div class="card">
            <h4>Creative Arts</h4>
            <p>Music, drawing, painting and creative expression.</p>
        </div>

        <div class="card">
            <h4>Physical Education</h4>
            <p>Sports, fitness, teamwork and healthy living.</p>
        </div>

        <div class="card">
            <h4>Social Studies</h4>
            <p>Community, citizenship and environmental awareness.</p>
        </div>
    </div>
</main>

