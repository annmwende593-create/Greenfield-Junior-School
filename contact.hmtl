<!DOCTYPE html>
<html>
<head><title>Contact Us - Greenfield</title><link rel="stylesheet" href="style.css"></head>
<body>
<header>
    <div class="logo">🎓 Greenfield Junior School</div>
    <nav>
        <a href="index.html">Home</a>
        <a href="about.html">About Us</a>
        <a href="academics.html">Academics</a>
        <a href="admissions.html">Admissions</a>
        <a href="contact.html" class="active">Contact Us</a>
    </nav>
</header>
<div class="container" style="display:block;">
    <h1>Contact Us</h1><br>
    <form onsubmit="return validateForm()">
        <label>Name:</label><br><input type="text" id="name" style="width:100%;padding:10px;margin:5px 0"><br>
        <label>Email:</label><br><input type="email" id="email" style="width:100%;padding:10px;margin:5px 0"><br>
        <label>Message:</label><br><textarea id="message" style="width:100%;padding:10px;height:100px;margin:5px 0"></textarea><br>
        <button type="submit" class="btn-green">Send Message</button>
    </form>
</div>
<footer>© 2026 Greenfield Junior School</footer>
<script>
function validateForm(){
    let n = document.getElementById('name').value;
    let e = document.getElementById('email').value;
    if(n=="" || e==""){ alert("Please fill in your name and email"); return false; }
    alert("Message sent successfully! We will contact you soon.");
    return false;
}
</script>
</body>
</html>
