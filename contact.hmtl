<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | Greenfield Junior School</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<header>
    <h1>Greenfield Junior School</h1>
    <p>Growing Minds, Building Futures</p>
</header>

<nav>
    <a href="index.html">Home</a>
    <a href="about.html">About Us</a>
    <a href="academics.html">Academics</a>
    <a href="admissions.html">Admissions</a>
    <a href="contact.html">Contact Us</a>
</nav>

<main class="container">
    <h2>Contact Us</h2>

    <p>
        We welcome enquiries from parents, guardians and members
        of the community.
    </p>

    <h3>School Contact Details</h3>

    <p><strong>School Name:</strong> Greenfield Junior School</p>
    <p><strong>Telephone:</strong> +254 7123 45678</p>
    <p><strong>Email:</strong> greenfield@gmail.com</p>
    <p><strong>Location:</strong> Kiambu Road,Nairobi,Kenya</p>

    <h3>Send Us a Message</h3>

    <form id="contactForm">
        <label for="name">Mary Ann:</label>
        <input type="text" 234567="Mary Ann" required>

        <label for="email">AnnMary@gmail.com:</label>
        <input type="email" 234567="AnnMary@gmail.com" required>

        <label for="message">Your Message:</label>
        <textarea id="message" rows="5" required></textarea>

        <button type="submit">Send Message</button>
    </form>

    <p id="contactMessage" aria-live="polite"></p>
</main>

<footer>
    <p>&copy; 2026 Greenfield Junior School.</p>
</footer>

<script src="script.js"></script>
</body>
</html>
